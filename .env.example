# ============================================
# M7 MCP Server - Environment Configuration
# ============================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ============================================

# ===========================================
# REQUIRED: API Keys for Hive Multiagent
# ===========================================

# OpenAI API Key (for GPT models and embeddings)
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-your-openai-key-here

# Anthropic API Key (for Claude models)
# Get from: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-api03-your-anthropic-key-here

# ===========================================
# OPTIONAL: ChromaDB Configuration
# ===========================================

# ChromaDB URL for vector memory (semantic search)
# Default: http://localhost:8000
CHROMA_URL=http://localhost:8000

# ===========================================
# OPTIONAL: Runtime Settings
# ===========================================

# Environment mode (development/production)
NODE_ENV=production

# Logging level (debug/info/warn/error)
LOG_LEVEL=info

# ===========================================
# OPTIONAL: M7 Mesh Relay (Multi-Machine)
# ===========================================

# Relay server URL (enables remote mesh mode)
# M7_MESH_RELAY=https://relay.yourdomain.com

# Shared secret for relay authentication
# M7_MESH_SECRET=your-shared-secret-here

# This workstation's name (unique per participant)
# M7_WORKSTATION=comp-a
